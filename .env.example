# Shared local proof storage. Keep this on a persistent local filesystem.
RESVARY_CREDITS_DB_PATH=.resvary/proof.sqlite

# Shared disposable Testnet wallets. Never commit the private key value.
RESVARY_TESTNET_BUYER_ADDRESS=
RESVARY_TESTNET_BUYER_PRIVATE_KEY=
RESVARY_TESTNET_SELLER_ADDRESS=

# Optional rail-specific overrides.
RESVARY_ARC_FUNDING_RECIPIENT=
RESVARY_ARC_BUYER_PRIVATE_KEY=
RESVARY_ARC_PROOF_AMOUNT=0.01
RESVARY_ARC_PROOF_CUSTOMER_ID=arc_proof
RESVARY_ARC_CONFIRMATIONS=1
RESVARY_ARC_RPC_URL=https://rpc.testnet.arc.network

# Circle Gateway Nanopayment proof.
RESVARY_ENABLE_LIVE_GATEWAY=false
RESVARY_GATEWAY_SELLER_ADDRESS=
RESVARY_GATEWAY_EXPECTED_PAYER=
RESVARY_GATEWAY_PROOF_AMOUNT=0.01
RESVARY_GATEWAY_PROOF_CUSTOMER_ID=gateway_proof
RESVARY_GATEWAY_PROOF_URL=http://localhost:3004/api/credits/gateway
RESVARY_GATEWAY_BUYER_PRIVATE_KEY=
# Optional one-time Testnet deposit. Leave blank after the buyer has Gateway balance.
RESVARY_GATEWAY_DEPOSIT=
RESVARY_GATEWAY_DEPOSIT_TX_HASH=
RESVARY_GATEWAY_DEPOSIT_AMOUNT=

# Optional shared proof run ID and output overrides.
RESVARY_PROOF_ID=
RESVARY_ARC_EVIDENCE_PATH=docs/evidence/arc-testnet-proof.json
RESVARY_GATEWAY_EVIDENCE_PATH=docs/evidence/gateway-nanopayment-proof.json

# Vercel storage is ephemeral. Keep false for release evidence.
RESVARY_ALLOW_EPHEMERAL_GATEWAY_PROOF=false
