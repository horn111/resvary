{
  "name": "create-resvary",
  "version": "1.0.0",
  "description": "CLI to scaffold Resvary prepaid AI credit applications",
  "bin": {
    "create-resvary": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run src",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/prompts": "^2.4.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "author": "horn111",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horn111/resvary.git",
    "directory": "packages/create-resvary"
  }
}
