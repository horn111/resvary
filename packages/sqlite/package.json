{
  "name": "@resvary/sqlite",
  "version": "0.5.0-alpha.3",
  "description": "SQLite persistence for Resvary credits, usage receipts, and payment receipts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@resvary/sdk": "0.5.0-alpha.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
