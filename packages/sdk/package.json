{
  "name": "@resvary/sdk",
  "version": "0.5.0-alpha.0",
  "description": "Prepaid credits and usage billing SDK for AI products",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "import": "./dist/credits/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.js"
    },
    "./funding/arc": {
      "types": "./dist/funding/arc.d.ts",
      "import": "./dist/funding/arc.js"
    },
    "./funding": {
      "types": "./dist/funding/index.d.ts",
      "import": "./dist/funding/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway/index.js"
    },
    "./receipts": {
      "types": "./dist/receipts/index.d.ts",
      "import": "./dist/receipts/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-credits",
    "prepaid-credits",
    "usage-metering",
    "ledger",
    "arc",
    "circle",
    "usdc",
    "nanopayments",
    "x402",
    "billing",
    "middleware",
    "paid-api",
    "micropayments",
    "usage-based-billing",
    "receipts",
    "invoices",
    "webhooks"
  ],
  "author": "horn111",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/horn111/resvary.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/horn111/resvary#readme",
  "bugs": {
    "url": "https://github.com/horn111/resvary/issues"
  },
  "dependencies": {
    "viem": "^2.55.8"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
