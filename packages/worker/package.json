{
  "name": "@resvary/worker",
  "version": "1.0.0-rc.1",
  "description": "Durable outbox delivery worker for Resvary",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "resvary-worker": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horn111/resvary.git",
    "directory": "packages/worker"
  },
  "dependencies": {
    "@resvary/postgres": "1.0.0-rc.1",
    "@resvary/sdk": "1.0.0-rc.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0"
}
