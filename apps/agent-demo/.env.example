# Copy to the repository root as .env.agent-demo.local (ignored by Git).
# Keep real secrets out of chat and the repository. Defaults do not enable runs.
AGENT_DEMO_ORIGIN=https://REPLACE-DEMO-DOMAIN
AGENT_DEMO_SECRET=REPLACE-WITH-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
AGENT_DEMO_WALLET=REPLACE-CIRCLE-AGENT-WALLET-SCA
AGENT_DEMO_PAYER=REPLACE-GATEWAY-BACKING-EOA
AGENT_DEMO_SELLER=REPLACE-ARC-TESTNET-SELLER-ADDRESS
AGENT_DEMO_ACCEPTING=false
AGENT_DEMO_TEST_MODE=false
AGENT_DEMO_EXECUTION_MODE=workflow
AGENT_DEMO_INITIAL_SPEND_UNITS=0
AGENT_DEMO_AGENT_PROVIDER=nous
AGENT_DEMO_AGENT_MODEL=qwen/qwen3.8-flash
AGENT_DEMO_ANALYSIS_PROVIDER=nous
AGENT_DEMO_ANALYSIS_MODEL=openai/gpt-4.1-mini
NOUS_API_KEY=
HYPERBOLIC_API_KEY=
OPENAI_API_KEY=
# Vercel Marketplace supplies DATABASE_URL for managed Neon PostgreSQL.
DATABASE_URL=
# Generate separately, at least 32 random characters. Authenticates maintenance.
CRON_SECRET=
# Export these using scripts/export-circle-session.ts after Testnet login.
# Keep the generated .env.circle-session.local file separate and ignored.
CIRCLE_AGENT_SESSION_BUNDLE=
CIRCLE_SESSION_ENCRYPTION_KEY=
# Legacy local Docker option only, not required by Vercel/Neon.
AGENT_DEMO_DB_PASSWORD=
